{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeLab Curriculum Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tracks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/track"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 3,
      "pattern": "\\S"
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "domain",
        "modules"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "domain": {
          "enum": [
            "mathematics",
            "programming",
            "graphics",
            "ai",
            "robotics",
            "other"
          ]
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/module"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "focus",
        "dependsOnModuleIds",
        "courseIds",
        "plannedCourses"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "focus": {
          "$ref": "#/$defs/text"
        },
        "dependsOnModuleIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "courseIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "plannedCourses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/planned"
          }
        }
      }
    },
    "planned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "scope"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
