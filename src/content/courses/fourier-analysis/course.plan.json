    {
      "id": "why-frequency",
      "title": "为什么我们需要“频率”这副眼镜？",
      "coreQuestion": "想保留一段信号的基本节奏、削弱较快的振动，为什么只看时间波形不够直观？为什么选择正弦？",
      "learningObjectives": [
        "读懂由两个正弦构成的信号的时域图和幅度谱",
        "说明为什么正弦信号适合描述周期振动及适用条件",
        "解释谐波序号与物理频率的区别"
      ],
      "conceptIds": [
        "periodic-function"
      ],
      "prerequisites": [
        "三角函数",
        "弧度制"
      ],
      "dependsOnChapterIds": [],
      "coreTask": "对 y(t)=sin(t)+0.45sin(3t)，预测去掉第 3 次谐波后波形和基本周期的变化，并解释为什么仅凭幅度谱不能重建任意信号。",
      "lessonPath": "src/content/lessons/why-frequency.mdx",
      "status": "prototype"
    },
    {
      "id": "frequency-projection",
      "title": "如果只给你混合波形，能找回每个频率吗？",
      "coreQuestion": "从只有时间波形、不知道配方的信号中，怎样独立求出各个频率的贡献，而不靠反复猜测？",
      "learningObjectives": [
        "解释函数内积与向量点积的联系和区别",
        "用有限正交投影推导三角系数并正确处理零频常数项",
        "应用公式提取简单混合函数的幅度和平均值"
      ],
      "conceptIds": [
        "orthogonality",
        "fourier-coefficients",
        "frequency-interpretation"
      ],
      "prerequisites": [
        "向量线性组合与投影直觉",
        "积分"
      ],
      "dependsOnChapterIds": [
        "why-frequency"
      ],
      "coreTask": "不用展开所有积分，计算 g(t)=2+cos(2t)+0.4sin(3t) 的平均值、a₂、b₃，并解释其余系数为什么为零。",
      "lessonPath": "src/content/lessons/frequency-projection.mdx",
      "status": "prototype"
    },
