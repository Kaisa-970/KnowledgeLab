{
  "schemaVersion": 2,
  "id": "fourier-analysis",
  "title": "傅里叶分析：从波形到频谱",
  "domain": "mathematics",
  "level": "foundation-to-intermediate",
  "summary": "从真实的信号分离问题出发，先理解频率视角和正弦为何有用，再把函数内积与向量投影连接起来，最后用方波探究 Gibbs 过冲和不同收敛方式。",
  "prerequisites": [
    "三角函数与弧度制",
    "定积分和简单的奇偶函数",
    "基本的向量与线性组合（可在第二节回顾）"
  ],
  "learningOutcomes": [
    "解释时域/频域两种视角和选择正弦成分的理由，并指出适用条件",
    "利用正交内积推导有限频率组合的最优平方误差系数",
    "利用奇偶与半波对称性计算方波谐波",
    "用实验和数学区分 Gibbs 过冲、逐点收敛、均方收敛与一致收敛"
  ],
  "knowledgeNodes": [
