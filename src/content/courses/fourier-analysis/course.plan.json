{
  "schemaVersion": 2,
  "id": "fourier-analysis",
  "title": "傅里叶分析：从波形到频谱",
  "domain": "mathematics",
  "level": "foundation-to-intermediate",
  "summary": "从播放器为什么能够调节高频这一可试听问题出发，用一个双正弦实验建立时域与频域的直觉；随后把频率提取与线性代数的投影连起来，再以方波探究 Gibbs 和收敛。",
  "prerequisites": [
    "三角函数与弧度制",
    "定积分和简单的奇偶函数",
    "基本的向量与线性组合（可在第二节回顾）"
  ],
  "learningOutcomes": [
    "解释时域/频域两种视角和选择正弦成分的理由，并指出适用条件",
    "利用正交内积推导有限频率组合的最优平方误差系数",
    "利用奇偶与半波对称性计算方波谐波",
    "用实验和数学区分 Gibbs 过冲、逐点收敛、均方收敛与一致收敛"
  ],
