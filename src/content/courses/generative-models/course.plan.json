      "dependsOnChapterIds": [],
      "coreTask": "不看正文，按第一幅图解释训练和生成分别需要哪些输入，参数与样本状态哪个会更新；说明不提供原图时模型仍能生成的前提。",
      "lessonPath": "src/content/lessons/generative-sampling-not-averaging.mdx",
      "status": "prototype"
