{
  "name": "knowledge-lab",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-content.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/math/*.test.ts scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "build": "npm run validate && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "katex": "^0.16.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^22.16.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
