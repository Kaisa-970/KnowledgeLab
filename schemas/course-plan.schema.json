{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeLab Course Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "status",
    "design",
    "domain",
    "level",
    "summary",
    "prerequisites",
    "learningOutcomes",
    "knowledgeNodes",
    "chapters",
    "plannedChapters"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/nonempty"
    },
    "status": {
      "enum": [
        "prototype",
        "reviewed",
        "published"
      ]
    },
    "design": {
      "$ref": "#/$defs/design"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "domain": {
      "enum": [
        "mathematics",
        "programming",
        "graphics",
        "ai",
        "robotics",
        "other"
      ]
    },
    "level": {
      "enum": [
        "foundation",
        "foundation-to-intermediate",
        "intermediate",
        "advanced"
      ]
    },
    "summary": {
      "$ref": "#/$defs/nonempty"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "learningOutcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "knowledgeNodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "plannedChapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/planned"
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "approvedBy",
        "evidencePath"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "approvedBy": {
          "$ref": "#/$defs/nonempty"
        },
        "evidencePath": {
          "type": "string",
          "pattern": "^src/content/courses/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*\\.md$"
        }
      }
    }
  },
  "$defs": {
    "withCoreTask": {
      "type": "object",
      "properties": {
        "coreTask": {
          "$ref": "#/$defs/nonempty"
        }
      },
      "required": [
        "coreTask"
      ]
    },
    "withLabs": {
      "type": "object",
      "properties": {
        "labIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "labIds"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 3,
      "pattern": "\\S"
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learningBriefPath",
        "knowledgeMapPath",
        "knowledgeLinksPath"
      ],
      "properties": {
        "learningBriefPath": {
          "type": "string",
          "pattern": "^src/content/courses/[a-z][a-z0-9-]*/learning-brief\\.md$"
        },
        "knowledgeMapPath": {
          "type": "string",
          "pattern": "^src/content/courses/[a-z][a-z0-9-]*/knowledge-map\\.md$"
        },
        "knowledgeLinksPath": {
          "type": "string",
          "pattern": "^src/content/courses/[a-z][a-z0-9-]*/knowledge-map\\.json$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportPath",
        "content",
        "mathematics",
        "browser",
        "visual",
        "chapterIds",
        "build",
        "authoredBy",
        "reviewedBy",
        "revision"
      ],
      "properties": {
        "reportPath": {
          "type": "string",
          "pattern": "^src/content/courses/[a-z][a-z0-9-]*/course-review\\.md$"
        },
        "content": {
          "$ref": "#/$defs/reviewState"
        },
        "mathematics": {
          "$ref": "#/$defs/reviewState"
        },
        "browser": {
          "$ref": "#/$defs/reviewState"
        },
        "visual": {
          "enum": [
            "pending",
            "passed",
            "not-applicable"
          ]
        },
        "chapterIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "build": {
          "$ref": "#/$defs/reviewState"
        },
        "authoredBy": {
          "$ref": "#/$defs/nonempty"
        },
        "reviewedBy": {
          "$ref": "#/$defs/nonempty"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "reviewState": {
      "enum": [
        "pending",
        "passed"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "dependsOn"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "coreQuestion",
        "learningObjectives",
        "conceptIds",
        "prerequisites",
        "dependsOnChapterIds",
        "lessonPath",
        "status"
      ],
      "anyOf": [
        {
          "$ref": "#/$defs/withCoreTask"
        },
        {
          "$ref": "#/$defs/withLabs"
        }
      ],
      "properties": {
        "coreTask": {
          "type": "string",
          "description": "当该节不适合交互实验时，替代 labIds 的可验证静态思考任务。"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "coreQuestion": {
          "$ref": "#/$defs/nonempty"
        },
        "dependsOnChapterIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "learningObjectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "conceptIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "labIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "lessonPath": {
          "type": "string",
          "pattern": "^src/content/lessons/[a-z0-9-]+\\.mdx$"
        },
        "status": {
          "enum": [
            "prototype",
            "reviewed",
            "published"
          ]
        }
      }
    },
    "planned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "dependsOnChapterIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "dependsOnChapterIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
